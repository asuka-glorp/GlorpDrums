# Git LFS configuration for large files
# Test images are tracked with LFS to keep repo size small

# Test snapshots
test/*.png filter=lfs diff=lfs merge=lfs -text
test/*.jpg filter=lfs diff=lfs merge=lfs -text

# Binary executables (should not be committed, but if they are)
check_raw_wav filter=lfs diff=lfs merge=lfs -text
test_crocell filter=lfs diff=lfs merge=lfs -text
test_menu filter=lfs diff=lfs merge=lfs -text

# Audio samples and kits
*.wav filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.glorpkit filter=lfs diff=lfs merge=lfs -text

# Documentation images
docs/*.png filter=lfs diff=lfs merge=lfs -text
docs/*.jpg filter=lfs diff=lfs merge=lfs -text

# Asset images
assets/*.png filter=lfs diff=lfs merge=lfs -text

# Font files
resources/fonts/*.ttf filter=lfs diff=lfs merge=lfs -text
resources/fonts/*.otf filter=lfs diff=lfs merge=lfs -text